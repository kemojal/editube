# Copy to .env locally; in Dokploy set each variable in the UI (do not commit secrets).

# --- Required ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET_KEY=change-me-long-random-string

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Encrypted API request logging ---
# Enable automatically when LOG_WRITE_DATABASE_URL is set. Set explicitly to
# 0 only for local development or an emergency capture shutdown.
# LOG_REQUESTS_ENABLED=1
# Public API only. Never supply the read URL to this process in production.
LOG_WRITE_DATABASE_URL=
# Internal-admin service only. Never supply the write URL to that process.
LOG_READ_DATABASE_URL=
LOG_PAYLOAD_ENCRYPTION_KEY=<GENERATED_FERNET_KEY>
LOG_PAYLOAD_ENCRYPTION_KEY_ID=2026-08-v1
LOG_HMAC_KEY=<GENERATED_RANDOM_32_BYTE_BASE64_KEY>
# JSON object containing retired key IDs needed until their payloads expire.
# LOG_PAYLOAD_DECRYPTION_KEYS={"2026-07-v1":"<OLD_FERNET_KEY>"}
# LOG_REQUEST_BODY_MAX_BYTES=65536
# LOG_RESPONSE_BODY_MAX_BYTES=131072
# LOG_QUEUE_MAX_SIZE=500
# LOG_WRITE_BATCH_SIZE=100
# LOG_WRITE_FLUSH_INTERVAL_MS=500
# LOG_SUCCESS_PAYLOAD_RETENTION_DAYS=3
# LOG_FAILURE_PAYLOAD_RETENTION_DAYS=14
# LOG_RETENTION_INTERVAL_HOURS=24
# Internal-admin deployment only; do not expose this origin publicly.
# LOG_ADMIN_CORS_ORIGINS=https://internal-admin.example.com
# Bootstrap scripts only. Prefer the direct, non-pooler owner URL and never
# supply it to either runtime service.
# LOG_MIGRATION_DATABASE_URL=
# LOG_WRITER_ROLE_PASSWORD=
# LOG_READER_ROLE_PASSWORD=
# Public URL of this API (OAuth redirects, server-side links)
BASE_URL=https://api.example.com

# Comma-separated browser origins allowed to call the API (must include your frontend URL)
CORS_ORIGINS=https://app.example.com

# --- Frontend URLs (emails, Stripe return, Google OAuth) ---
FRONTEND_BASE_URL=https://app.example.com
FRONTEND_GOOGLE_CALLBACK_URL=https://app.example.com/google/callback

# --- Optional: Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
#
# Catalog: checkout reads Price IDs from DB rows synced via product/price webhooks
# or bootstrap. Set a long random secret for POST /billing/sync-catalog:
# STRIPE_CATALOG_SYNC_SECRET=
#
# One-release migration: if catalog rows are missing, fall back to env price IDs:
# STRIPE_PRICE_FALLBACK=0
#
# Deprecated for normal operation (use Stripe Price metadata + catalog sync instead):
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_SCALE_MONTHLY=
# STRIPE_PRICE_SCALE_ANNUAL=
# Legacy aliases still read when STRIPE_PRICE_FALLBACK=1:
# STRIPE_PRICE_BASIC_MONTHLY=
# STRIPE_PRICE_BASIC_ANNUAL=
# STRIPE_PRICE_ELITE_MONTHLY=
# STRIPE_PRICE_ELITE_ANNUAL=
# Optional fixed-expiry campaign applied by Stripe Checkout.
# MARKETING_OFFER_ENABLED=true
# MARKETING_OFFER_CAMPAIGN_ID=pro-annual-launch-2026
# MARKETING_OFFER_PROMOTION_CODE_ID=promo_...
# MARKETING_OFFER_PUBLIC_CODE=EDITUBE25
# MARKETING_OFFER_PLAN=pro
# MARKETING_OFFER_INTERVAL=year
# MARKETING_OFFER_PERCENT_OFF=25
# MARKETING_OFFER_END_AT=2026-08-05T23:59:59Z
# MARKETING_OFFER_DURATION_LABEL=first year
# STRIPE_CONNECT_DEFAULT_COUNTRY=US

# Cash affiliate program. Keep both gates off until legal/finance approval.
# Publishing terms is rejected unless the first flag is enabled and the stored
# checksum matches the legal copy deployed in app/services/affiliate_program.py.
# AFFILIATE_LEGAL_APPROVED=0
# Production requires four distinct MFA-backed database approvals for each
# immutable terms version. Keep this off; local-only single-admin rehearsals may
# set the override below, but production must leave it disabled.
# AFFILIATE_ALLOW_MULTIROLE_APPROVER=0
# Comma-separated ISO country codes approved for this Stripe platform's actual
# payout corridors. Leave empty to keep applications closed. Express account
# availability alone is not proof that a cross-border transfer is permitted.
# AFFILIATE_SUPPORTED_COUNTRIES=
# Real Stripe transfers are rejected unless this second, independent gate is on.
# AFFILIATE_PAYOUTS_ENABLED=0
# A dedicated random value is recommended for keyed IP/UA hashes. Falls back to
# JWT secret only for local development.
# AFFILIATE_HASH_SECRET=
# Optional in-process invariant monitor. Prefer one designated API replica or
# an external scheduler in multi-replica production to avoid duplicate checks.
# AFFILIATE_MONITOR_INTERVAL_MINUTES=15
# AFFILIATE_ALERT_COOLDOWN_MINUTES=60
# Cache the public sanitized health computation to bound probe load (5-300s).
# AFFILIATE_HEALTH_CACHE_SECONDS=60
# HTTPS endpoint receiving sanitized status/count/code summaries only.
# AFFILIATE_ALERT_WEBHOOK_URL=
# Data minimization. Click detail cannot be kept for less than the 60-day
# attribution window; the scheduled sweep is off until explicitly enabled.
# AFFILIATE_CLICK_DETAIL_RETENTION_DAYS=90
# AFFILIATE_ACCEPTANCE_HASH_RETENTION_DAYS=90
# AFFILIATE_PRIVACY_RETENTION_INTERVAL_HOURS=24
# Referral email delivery operations. The provider webhook calls
# POST /public/referrals/email-events with X-Referral-Webhook-Secret.
# REFERRAL_EMAIL_WEBHOOK_SECRET=
# Stable HMAC key for bounce/complaint/unsubscribe suppressions. Do not rotate
# without re-hashing existing suppressions from a protected source of truth.
# REFERRAL_EMAIL_HASH_SECRET=
# REFERRAL_DELIVERY_RETRY_INTERVAL_MINUTES=5
# Raw addresses on unclaimed expired invites are scrubbed after this many days.
# REFERRAL_INVITE_EMAIL_RETENTION_DAYS=30

# Product analytics and reliability. POSTHOG_PROJECT_API_KEY is the ingestion
# project token, not a personal/admin key. Authoritative API/worker/Stripe
# events are delivered asynchronously from analytics_outbox.
# APP_ENV=production
# RELEASE=<git-sha>
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_API_HOST=https://us.posthog.com
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=
# PostHog workspace group type index used by the managed dashboard sync.
# POSTHOG_WORKSPACE_GROUP_TYPE_INDEX=0
# ANALYTICS_CONSENT_VERSION=2026-08-27
# ANALYTICS_REGION_POLICY=default
#
# ANALYTICS_DELIVERY_INTERVAL_SECONDS=30
# ANALYTICS_DELIVERY_TIMEOUT_SECONDS=10
# ANALYTICS_RETENTION_INTERVAL_HOURS=24
# ANALYTICS_QUALITY_INTERVAL_SECONDS=300
# ANALYTICS_RAW_EVENT_RETENTION_DAYS=456
# ANALYTICS_FEEDBACK_RETENTION_DAYS=365
# ANALYTICS_FEEDBACK_COOLDOWN_DAYS=30
# ANALYTICS_AUDIT_RETENTION_DAYS=760
# Optional dedicated Fernet key; TOKEN_ENCRYPTION_KEY is the fallback.
# ANALYTICS_FEEDBACK_ENCRYPTION_KEY=
#
#
# Optional shared fallback. Prefer the role-specific DSNs when API and worker
# events should be isolated in separate Sentry projects.
# SENTRY_DSN=
# SENTRY_API_DSN=
# SENTRY_WORKER_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0
# Provider configuration sync (server-side only).
# SENTRY_ORG=
# SENTRY_AUTH_TOKEN=
# SENTRY_API_HOST=https://sentry.io
# SENTRY_FRONTEND_PROJECT=
# SENTRY_API_PROJECT=
# SENTRY_WORKER_PROJECT=
# Optional `team:<id>` or `user:<id>` owner for managed monitors.
# SENTRY_ALERT_OWNER=
# Freelancer invoices: allow platform-hosted Stripe invoices without Connect (dev only).
# FREELANCER_ALLOW_PLATFORM_INVOICES=false
# Signed contract PDFs upload to Cloudinary when configured:
# CLOUDINARY_CONTRACTS_FOLDER=contracts

# --- Optional: SMTP ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# SMTP_USE_TLS=true

# --- Optional: Google OAuth ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_YOUTUBE_REDIRECT_URI=https://api.example.com/users/google/youtube/callback
# FRONTEND_YOUTUBE_OAUTH_RETURN_URL=https://app.example.com/?youtube_connected=1

# --- Optional: Google Drive import (create-project wizard "Google Drive" source) ---
# Uses the narrow `drive.file` scope only — no restricted-scope CASA audit needed.
# GOOGLE_DRIVE_REDIRECT_URI=https://api.example.com/users/google/drive/callback
# GOOGLE_PICKER_API_KEY=          # browser API key, restrict it to your frontend origins
# GOOGLE_PICKER_APP_ID=           # your Google Cloud *project number* (IAM & Admin > Settings)
# DRIVE_IMPORT_MAX_FILE_SIZE_MB=10240
# DRIVE_IMPORT_JOB_TIMEOUT_SEC=3600

# --- Optional: Zoom connection (Settings > Connected apps > Zoom; imports cloud recordings) ---
# Create a User-managed OAuth app in the Zoom Marketplace. Scopes: cloud_recording:read, user:read.
# Register the redirect URL below (byte-exact) in the Zoom app's OAuth settings.
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_REDIRECT_URI=https://api.example.com/users/zoom/callback


# --- YouTube Data API token encryption (required to save YouTube OAuth refresh tokens) ---
# Also required for Google Drive refresh tokens.
# TOKEN_ENCRYPTION_KEY=   # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Optional: dry-run YouTube publish job (no API upload) ---
# YOUTUBE_PUBLISH_DRY_RUN=0

# --- Optional: Redis (transcription, YouTube publish, aspect exports, chapter synthesis, mention emails) ---
# REDIS_URL=redis://127.0.0.1:6379/0
# Local Redis starts a supervised default-queue worker automatically. Set false
# when workers run separately; set true to opt in when Redis is remote.
# AUTO_START_RQ_WORKER=
# DELIVERY_PACKAGES_ENABLED=1
# DELIVERY_LINK_DEFAULT_DAYS=30
# RETENTION_SCAN_INTERVAL_HOURS=24
# COLD_STORAGE_ENABLED=0

# --- Optional: transcription tuning ---
# WHISPER_MODEL_SIZE=base
# TRANSCRIPTION_DEVICE=cpu
# TRANSCRIPTION_COMPUTE_TYPE=int8
# WHISPER_WORD_TIMESTAMPS=1                # Word-level timestamps (1|0); set 0 to disable

# --- Optional: Gemini AI features ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# --- Optional: Proxy generation (requires ffmpeg on $PATH) ---
# PROXY_AUTO_GENERATE=0                    # Auto-generate proxy on video upload (0|1)
# PROXY_DEFAULT_PROFILE=540p_h264          # 540p_h264 | 720p_h264 | 1080p_h264
# PROXY_STORAGE=cloudinary                 # cloudinary | local
# PROXY_LOCAL_DIR=./proxies                # Local proxy output dir when PROXY_STORAGE=local
# FFMPEG_PATH=ffmpeg                       # Custom ffmpeg binary path
# FFPROBE_PATH=ffprobe                     # Custom ffprobe binary path

# --- Optional: Watch folder ---
# WATCH_FOLDER_MAX_FILE_SIZE_MB=10240      # Max file size for watch folder uploads (MB)

# --- Optional: Camera-to-cloud ingest ---
# INGEST_AUTO_PROXY=1                      # Auto-proxy on mobile/agent upload

# --- Docker only: run DB migrations on container start (set to 1 to enable) ---
# RUN_MIGRATIONS_ON_START=0

# --- AI UGC Ads ---
# FEATURE_AI_UGC=1                         # 0/false disables the AI UGC module (default on)
# UGC_AVATAR_PROVIDER=stub                 # stub | heygen | creatify
# UGC_VOICE_PROVIDER=stub                  # stub | elevenlabs
# HEYGEN_API_KEY=                          # required when UGC_AVATAR_PROVIDER=heygen
# HEYGEN_TEST_MODE=0                        # 1 = watermarked HeyGen test renders (free tier)
# HEYGEN_API_BASE=https://api.heygen.com
# UGC_PROVIDER_POLL_SEC=15                  # poll interval while a provider renders
# UGC_PROVIDER_POLL_BUDGET_SEC=1200         # max seconds a render job waits for the provider
# CREATIFY_API_KEY=                        # required when UGC_AVATAR_PROVIDER=creatify
# CREATIFY_API_ID=
# ELEVENLABS_API_KEY=                      # required when UGC_VOICE_PROVIDER=elevenlabs
# UGC_PROVIDER_WEBHOOK_SECRET=             # verifies POST /ugc/providers/{name}/webhook
# UGC_RENDER_DRY_RUN=0                     # 1 forces the stub provider + local storage (no spend, no Cloudinary)
# UGC_RENDER_JOB_TIMEOUT_SEC=7200
# UGC_MAX_VARIATIONS_PER_BATCH=100
# UGC_CREDIT_COST_PER_VARIATION=1
# CLOUDINARY_UGC_FOLDER=aiugc
# UGC_OUTPUT_DIR=./uploads/ugc
#
OPENROUTER_API_KEY=           # local render output (when not on Cloudinary)
# Enhance Audio: auto uses local Demucs + the isolated DeepFilterNet runtime
# when installed, then falls back to FFmpeg. Set http + URL to use a dedicated
# model service instead. Never point AUDIO_DEEPFILTER_PYTHON at the main ML venv.
AUDIO_ENHANCE_PROVIDER=auto
AUDIO_DEEPFILTER_PYTHON=.venv-audio-enhance/bin/python
# AUDIO_ENHANCE_URL=

# Internal caption-template editing (rough-cut editor "Template studio").
# Comma-separated emails, or "*" to allow every authenticated user (local dev only).
# CAPTION_TEMPLATE_EDITORS=you@example.com
