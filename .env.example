# Copy to .env locally; in Dokploy set each variable in the UI (do not commit secrets).

# --- Required ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET_KEY=change-me-long-random-string

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL of this API (OAuth redirects, server-side links)
BASE_URL=https://api.example.com

# Comma-separated browser origins allowed to call the API (must include your frontend URL)
CORS_ORIGINS=https://app.example.com

# --- Frontend URLs (emails, Stripe return, Google OAuth) ---
FRONTEND_BASE_URL=https://app.example.com
FRONTEND_GOOGLE_CALLBACK_URL=https://app.example.com/google/callback

# --- Optional: Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_*=

# --- Optional: SMTP ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# SMTP_USE_TLS=true

# --- Optional: Google OAuth ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Optional: Redis (transcription queue + any Redis features) ---
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Optional: transcription tuning ---
# WHISPER_MODEL_SIZE=base
# TRANSCRIPTION_DEVICE=cpu
# TRANSCRIPTION_COMPUTE_TYPE=int8

# --- Optional: Gemini AI features ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# --- Docker only: run DB migrations on container start (set to 1 to enable) ---
# RUN_MIGRATIONS_ON_START=0
